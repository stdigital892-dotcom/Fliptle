<?xml version="1.0" encoding="utf-8"?>
<!--
  Welcome / hero background: mirrors fliptle.com's hero overlay stack. Near-black
  ground, a top-biased urgent-red radial glow (CSS: radial-gradient(120% 90% at
  50% -8%, rgba(255,34,51,.16), transparent 55%)), and a bottom scrim so
  headlines/CTAs stay readable (CSS: linear-gradient to rgba(6,6,8,.97)).
  Vector-only, no bitmap — scales to any screen.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: near-black -->
    <item android:drawable="@color/graphite" />

    <!-- Urgent-red radial glow, top-centre, approx 16% alpha falling to 0 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="-0.08"
                android:gradientRadius="90%p"
                android:startColor="#29FF2233"
                android:centerColor="#0DFF2233"
                android:endColor="#00FF2233" />
        </shape>
    </item>

    <!-- Bottom scrim: darken the lower third so text/buttons retain contrast -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#00060608"
                android:centerColor="#73060608"
                android:endColor="#F2060608" />
        </shape>
    </item>

    <!-- Soft vignette for the corners -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.42"
                android:gradientRadius="120%p"
                android:startColor="#00000000"
                android:centerColor="#00000000"
                android:endColor="#CC000000" />
        </shape>
    </item>
</layer-list>

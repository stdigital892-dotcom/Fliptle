<?xml version="1.0" encoding="utf-8"?>
<!--
  Once-per-account, unskippable process explainer shown between sign-in and Home.
  The "Got it" button stays disabled until the user has scrolled to the very end.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <ScrollView
        android:id="@+id/uninstallInfoScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Headline -->
            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uninstall_info_title"
                android:textColor="@color/accent" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/uninstall_info_lede" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/border" />

            <!-- Step 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_bg"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/step_number_bg"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/accent_ico"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/uninstall_info_step1" />
            </LinearLayout>

            <!-- Step 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/step_number_bg"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/accent_ico"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/uninstall_info_step2" />
            </LinearLayout>

            <!-- Step 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/step_number_bg"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/accent_ico"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/uninstall_info_step3" />
            </LinearLayout>

            <!-- Step 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/step_number_bg"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/accent_ico"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/uninstall_info_step4" />
            </LinearLayout>

            <!-- Step 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/step_number_bg"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/accent_ico"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/uninstall_info_step5" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="@color/border" />

            <!-- Caution — stronger visual weight than the steps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/caution_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/uninstall_info_caution_title"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.25" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/uninstall_info_caution_lede"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.45" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/uninstall_info_caution_bullets"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.55" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/uninstall_info_caution_final"
                    android:textColor="@color/accent_ico"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="@color/border" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/uninstall_info_close" />
        </LinearLayout>
    </ScrollView>

    <!-- Scroll-to-bottom hint (shows until the user reaches the end). -->
    <TextView
        android:id="@+id/scrollHintText"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/uninstall_info_scroll_hint" />

    <Button
        android:id="@+id/gotItButton"
        style="@style/Widget.Fliptle.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:enabled="false"
        android:text="@string/uninstall_info_got_it" />
</LinearLayout>

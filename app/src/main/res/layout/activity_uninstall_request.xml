<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uninstall_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/uninstall_body"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/uninstallStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/uninstallCountdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/startDayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Math session -->
        <LinearLayout
            android:id="@+id/mathSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/mathProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="30sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/answerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/math_answer_hint"
                android:importantForAutofill="no"
                android:inputType="numberSigned" />

            <Button
                android:id="@+id/submitAnswerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/math_submit" />

            <TextView
                android:id="@+id/mathErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#B71C1C"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Typing session (second gate: type 1..50, per-keystroke, no paste) -->
        <LinearLayout
            android:id="@+id/typingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uninstall_typing_prompt"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/typingProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="15sp" />

            <com.fliptle.app.NoPasteEditText
                android:id="@+id/typingField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/typing_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:textIsSelectable="false" />

            <TextView
                android:id="@+id/typingErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#B71C1C"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Options -->
        <CheckBox
            android:id="@+id/resetOnMissCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/uninstall_reset_on_miss" />

        <CheckBox
            android:id="@+id/debugDaysCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uninstall_debug_days" />

        <CheckBox
            android:id="@+id/heartbeatDebugCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uninstall_debug_heartbeat" />

        <Button
            android:id="@+id/cancelRequestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/uninstall_cancel" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uninstall_title" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/uninstall_body" />

        <TextView
            android:id="@+id/uninstallStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/uninstallCountdownText"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent_ico"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/startDayButton"
            style="@style/Widget.Fliptle.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Math session -->
        <LinearLayout
            android:id="@+id/mathSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/mathProgressText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:textStyle="bold"
                android:textSize="30sp" />

            <EditText
                android:id="@+id/answerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/math_answer_hint"
                android:importantForAutofill="no"
                android:textColor="@color/ink"
                android:inputType="numberSigned" />

            <Button
                android:id="@+id/submitAnswerButton"
                style="@style/Widget.Fliptle.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/math_submit" />

            <TextView
                android:id="@+id/mathErrorText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/notice_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Typing session (type 1..50, per-keystroke, no paste) -->
        <LinearLayout
            android:id="@+id/typingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/uninstall_typing_prompt" />

            <TextView
                android:id="@+id/typingProgressText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.fliptle.app.NoPasteEditText
                android:id="@+id/typingField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/typing_hint"
                android:importantForAutofill="no"
                android:textColor="@color/ink"
                android:inputType="number"
                android:textIsSelectable="false" />

            <TextView
                android:id="@+id/typingErrorText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/notice_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Developer-only switches (hidden unless DevMode is unlocked). -->
        <CheckBox
            android:id="@+id/debugDaysCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:buttonTint="@color/accent"
            android:textColor="@color/ink"
            android:text="@string/uninstall_debug_days" />

        <CheckBox
            android:id="@+id/heartbeatDebugCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/accent"
            android:textColor="@color/ink"
            android:text="@string/uninstall_debug_heartbeat" />

        <Button
            android:id="@+id/cancelRequestButton"
            style="@style/Widget.Fliptle.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/uninstall_cancel" />

    </LinearLayout>
</ScrollView>

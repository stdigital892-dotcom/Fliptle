<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/freeze_eyebrow" />

        <TextView
            android:id="@+id/freezeTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/freeze_title" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/freeze_body" />

        <TextView
            android:id="@+id/cycleStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="@color/ink"
            android:fontFamily="@font/anton_regular"
            android:textAllCaps="true"
            android:textSize="30sp"
            android:letterSpacing="0.01"
            android:lineSpacingMultiplier="1.0" />

        <TextView
            android:id="@+id/cycleDetailText"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/reviewNoticeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/notice_bg"
            android:padding="14dp"
            android:lineSpacingMultiplier="1.45"
            android:textColor="@color/notice_text"
            android:textSize="13sp"
            android:text="@string/freeze_review_body"
            android:visibility="gone" />

        <!-- The only way to choose what to block. Opens the wizard; locks nothing.
             Hidden while the 3-day lock is running (status only). -->
        <Button
            android:id="@+id/setupFreezeButton"
            style="@style/Widget.Fliptle.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/freeze_setup_button" />

        <TextView
            android:id="@+id/devStatusText"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/accent_ico"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

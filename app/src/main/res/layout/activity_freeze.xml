<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/freezeTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/freeze_title" />

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/freeze_body" />

        <TextView
            android:id="@+id/cycleStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="@color/ink"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textSize="22sp"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/cycleDetailText"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/startCycleButton"
            style="@style/Widget.Fliptle.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/freeze_start" />

        <TextView
            android:id="@+id/reviewNoticeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/notice_bg"
            android:padding="14dp"
            android:lineSpacingMultiplier="1.45"
            android:textColor="@color/notice_text"
            android:textSize="13sp"
            android:text="@string/freeze_review_body"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/border" />

        <TextView
            style="@style/Text.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/freeze_covers_title" />

        <TextView
            android:id="@+id/coversLockText"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingMultiplier="1.4" />

        <LinearLayout android:id="@+id/blockedAppsButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/card_bg"
            android:foreground="?attr/selectableItemBackground" android:clickable="true"
            android:focusable="true" android:gravity="center_vertical"
            android:orientation="horizontal" android:padding="16dp">
            <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/icon_well">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                    android:src="@drawable/ic_apps" android:contentDescription="@null" /></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView style="@style/Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setup_apps" />
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/freeze_apps_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/blockedDomainsButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/card_bg"
            android:foreground="?attr/selectableItemBackground" android:clickable="true"
            android:focusable="true" android:gravity="center_vertical"
            android:orientation="horizontal" android:padding="16dp">
            <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/icon_well">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                    android:src="@drawable/ic_domains" android:contentDescription="@null" /></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView style="@style/Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setup_domains" />
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/freeze_domains_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/surfacesButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/card_bg"
            android:foreground="?attr/selectableItemBackground" android:clickable="true"
            android:focusable="true" android:gravity="center_vertical"
            android:orientation="horizontal" android:padding="16dp">
            <FrameLayout android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/icon_well">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center"
                    android:src="@drawable/ic_shorts" android:contentDescription="@null" /></FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView style="@style/Text.CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setup_surfaces" />
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/freeze_shorts_sub" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/devStatusText"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/accent_ico"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

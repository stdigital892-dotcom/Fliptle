<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Shared title: shown by the Account view only (set in code). The sign-in
             face has its own centred wordmark and heading inside signInControls. -->
        <TextView
            android:id="@+id/authTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_title"
            android:visibility="gone" />

        <!-- Account view (already signed in) -->
        <LinearLayout
            android:id="@+id/accountSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/accountEmailText"
                    style="@style/Text.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/accountDetailText"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/signOutButton"
                style="@style/Widget.Fliptle.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/auth_sign_out" />

            <!-- Shown INSTEAD of the Sign out button while sign-out is locked. -->
            <TextView
                android:id="@+id/signOutLockedText"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/notice_bg"
                android:padding="14dp"
                android:text="@string/sign_out_locked"
                android:textColor="@color/notice_text"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/auth_sign_out_note" />

            <!-- Shown only while an account deletion is scheduled -->
            <TextView
                android:id="@+id/deletionBanner"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/notice_bg"
                android:padding="14dp"
                android:textColor="@color/notice_text"
                android:visibility="gone" />

            <Button
                android:id="@+id/cancelDeletionButton"
                style="@style/Widget.Fliptle.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/deletion_cancel_button"
                android:visibility="gone" />

            <Button
                android:id="@+id/deleteAccountButton"
                style="@style/Widget.Fliptle.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:text="@string/auth_delete_account" />
        </LinearLayout>

        <!-- Sign-in controls (mandatory gate): Google is the only way in. The column is
             centred; the Google button keeps its own size and aspect ratio. -->
        <LinearLayout
            android:id="@+id/signInControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Shown after deletion was scheduled and this phone signed out:
                 "Your account will be deleted on ... Sign in again before then to cancel." -->
            <TextView
                android:id="@+id/deletionNoticeText"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/notice_bg"
                android:padding="14dp"
                android:textColor="@color/notice_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/authWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:fontFamily="@font/anton_regular"
                android:letterSpacing="0.06"
                android:text="@string/auth_wordmark"
                android:textAllCaps="true"
                android:textColor="@color/ink"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/signInHeading"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/auth_title" />

            <!-- Google's official branded "Sign in with Google" button (Neutral,
                 text, square, Android+Web), used unmodified from the four PNG
                 densities in drawable-{m,xh,xxh,xxxh}dpi via the state selector
                 google_signin_button_src.xml. No recolor, crop or stretch:
                 scaleType="fitCenter" + adjustViewBounds="true" preserves the
                 asset's aspect ratio, and the view's wrap_content lets Android
                 size itself to the PNG at the matching density. The 48dp minHeight
                 gives a touch target that meets the Material minimum without
                 scaling the image. -->
            <ImageButton
                android:id="@+id/googleSignInButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:minHeight="48dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackground"
                android:padding="0dp"
                android:src="@drawable/google_signin_button_src"
                android:contentDescription="@string/auth_google_cd" />


            <TextView
                android:id="@+id/googleNoteText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/auth_google_note" />

            <TextView
                android:id="@+id/legalNoticeText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <!-- Deletion check after a fresh sign-in: "Checking your account..." while it
             runs; if the check or the cancel fails, the message plus Retry (and Sign
             out as a way out). The user stays here until it succeeds. -->
        <LinearLayout
            android:id="@+id/deletionCheckSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/deletionCheckText"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/deletionCheckRetryButton"
                style="@style/Widget.Fliptle.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/deletion_signin_retry"
                android:visibility="gone" />

            <Button
                android:id="@+id/deletionCheckSignOutButton"
                style="@style/Widget.Fliptle.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/auth_sign_out"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Onboarding progress indicator — visible only while OnboardingState
             isn't yet complete (see SignInActivity); hidden for a returning
             user re-signing in on an already-onboarded device. -->
        <LinearLayout
            android:id="@+id/authProgressSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/authProgressText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ProgressBar
                android:id="@+id/authProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressBackgroundTint="@color/border"
                android:progressTint="@color/accent" />
        </LinearLayout>

        <!-- Optional name step, shown once after sign-in. Leaving the field blank
             IS how you skip it; there is a single Continue button. -->
        <LinearLayout
            android:id="@+id/profileSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Text.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_profile_title" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/auth_name_hint" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autofillHints="name"
                android:hint="@string/auth_name_field"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="40"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/continueProfileButton"
                style="@style/Widget.Fliptle.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/auth_profile_continue" />
        </LinearLayout>

        <TextView
            android:id="@+id/authStatusText"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:lineSpacingMultiplier="1.4" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/blocked_domains" />

    <EditText
        android:id="@+id/domainInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/domain_hint"
        android:importantForAutofill="no"
        android:textColor="@color/ink"
        android:inputType="textUri" />

    <Button
        android:id="@+id/addDomainButton"
        style="@style/Widget.Fliptle.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/add_domain" />

    <ListView
        android:id="@+id/domainList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:divider="@color/border"
        android:dividerHeight="1dp" />

</LinearLayout>

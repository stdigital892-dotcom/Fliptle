<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/porn_title" />

        <TextView
            android:id="@+id/pornStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/ink"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textSize="28sp"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/pornBodyText"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/enableSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/notice_bg"
                android:lineSpacingMultiplier="1.3"
                android:padding="16dp"
                android:text="@string/porn_warning"
                android:textColor="@color/notice_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/understandCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:buttonTint="@color/accent"
                android:textColor="@color/ink"
                android:text="@string/porn_understand" />

            <Button
                android:id="@+id/enablePornBlockButton"
                style="@style/Widget.Fliptle.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="@string/porn_enable" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

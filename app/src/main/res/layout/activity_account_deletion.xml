<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account_delete_title" />

        <!-- Text is built in code: it contains the numbers from DeletionConfig. -->
        <TextView
            android:id="@+id/deleteBodyText"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/deleteStatusText"
            style="@style/Text.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/deleteCountdownText"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent_ico"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/startDayButton"
            style="@style/Widget.Fliptle.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Shown once every day is complete: asks the server to schedule deletion. -->
        <Button
            android:id="@+id/requestDeletionButton"
            style="@style/Widget.Fliptle.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/account_delete_request_button"
            android:visibility="gone" />

        <!-- Math session -->
        <LinearLayout
            android:id="@+id/mathSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/mathProgressText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:fontFamily="@font/anton_regular"
                android:textAllCaps="true"
                android:letterSpacing="0.01"
                android:lineSpacingMultiplier="1.0"
                android:textSize="36sp" />

            <EditText
                android:id="@+id/answerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/account_delete_math_hint"
                android:importantForAutofill="no"
                android:textColor="@color/ink"
                android:inputType="numberSigned" />

            <Button
                android:id="@+id/submitAnswerButton"
                style="@style/Widget.Fliptle.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/account_delete_math_submit" />

            <TextView
                android:id="@+id/mathErrorText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/notice_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Typing session (type 1..50, per-keystroke, no paste) -->
        <LinearLayout
            android:id="@+id/typingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- Text is built in code: it contains the typing range from DeletionConfig. -->
            <TextView
                android:id="@+id/typingPromptText"
                style="@style/Text.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/typingProgressText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <com.fliptle.app.NoPasteEditText
                android:id="@+id/typingField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/account_delete_typing_hint"
                android:importantForAutofill="no"
                android:textColor="@color/ink"
                android:inputType="number"
                android:textIsSelectable="false" />

            <TextView
                android:id="@+id/typingErrorText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/notice_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Developer-only switches (hidden unless DevMode is unlocked). -->
        <CheckBox
            android:id="@+id/deleteDebugDaysCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:buttonTint="@color/accent"
            android:textColor="@color/ink"
            android:text="@string/account_delete_debug_days" />

        <Button
            android:id="@+id/cancelDeleteRequestButton"
            style="@style/Widget.Fliptle.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/account_delete_cancel" />

    </LinearLayout>
</ScrollView>
